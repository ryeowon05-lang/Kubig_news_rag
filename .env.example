# 어떤 프로바이더를 쓸지. anthropic | openai | openrouter (기본값: anthropic)
LLM_PROVIDER=anthropic

# --- Anthropic ---
# (do NOT commit a real key)
ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-sonnet-5

# --- OpenAI ---
# LLM_PROVIDER=openai 일 때만 필요합니다. 모델 기본값은 없습니다.
OPENAI_API_KEY=
OPENAI_MODEL=
# 호환 게이트웨이를 쓸 때만 지정합니다. 비워두면 OpenAI 기본 주소를 씁니다.
OPENAI_BASE_URL=

# --- OpenRouter ---
# LLM_PROVIDER=openrouter 일 때만 필요합니다. base_url은 코드에 고정돼 있습니다.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
